# Copy to backend/.env and fill in.

# REQUIRED - Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional - vision model and fallbacks used when the main one is busy / rate-limited
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest

# Administrator account created on first start (controller@ and inspector@ demo accounts are
# created too). Change passwords from the Admin page before any real use.
ADMIN_EMAIL=official@metrology.gov.in
ADMIN_PASSWORD=admin123
ADMIN_NAME=State Controller

# Letterhead printed on show-cause notices
OFFICE_NAME=Office of the Controller of Legal Metrology
OFFICE_ADDRESS=Legal Metrology Department

# Public complaint portal: submissions allowed per IP per hour
COMPLAINTS_PER_HOUR=5

# Session signing key. Leave empty to auto-generate one in backend/data/.secret_key
SECRET_KEY=
TOKEN_TTL_HOURS=12

# Optional - "Sign in with Google". OAuth 2.0 *Web* client ID from Google Cloud console
# (Authorised JavaScript origin: http://localhost:3000). Officers sign in with Google only if
# their Google e-mail matches an existing officer account. The client secret is not needed.
GOOGLE_CLIENT_ID=

# Set to "production" on a live server. Startup then refuses the demo defaults: SECRET_KEY must be
# set, ADMIN_PASSWORD changed, CORS_ORIGINS not localhost, and the demo controller/inspector
# accounts are not created. Put real values in the host's secret settings, never in code.
# PRAMITI_ENV=production

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional
# DATABASE_URL=sqlite:///./compliance.db
# UPLOAD_DIR=./uploads              # inspection photos; on a server, a persistent disk
# MAX_UPLOAD_MB=15
# RULES_PDF_PATH=../sih_eng.pdf
# PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf

# Backups (python backup.py): where to write them and how many days to keep
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
