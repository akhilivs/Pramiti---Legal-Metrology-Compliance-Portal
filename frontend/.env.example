# Copy to frontend/.env.local if you need to change these.

# Where the FastAPI backend runs
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "false" to hide the demo-credentials hint on the sign-in page
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# "Sign in with Google" OAuth web client ID (same as GOOGLE_CLIENT_ID in backend/.env).
# Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
